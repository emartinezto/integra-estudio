<section class="section">
  <div class="container">
    {{ sectionHead("Bases de nuestra práctica", "Los Tres Pilares", "Una atención cercana y personalizada, adaptada a ti, a tu ritmo y a lo que necesitas en cada momento.") }}
    <div style="display: flex; flex-direction: column; gap: 32px;">
      {{ pillar("Pilar I", "Cuerpo", "Prevención · Fisioterapia · Recuperación", "Valoramos lo que necesitas y trabajamos contigo para entender el origen de tus molestias, tratar el dolor y ayudarte a recuperar el bienestar y la confianza en tu cuerpo.", "Descubrir Cuerpo", "/cuerpo/", "Fotografía: sesión de fisioterapia") }}
      {{ pillar("Pilar II", "Mente", "Orientación · Apoyo · Formación", "Te acompañamos en momentos de cambio, en tus procesos de formación y en aquellos momentos en los que necesitas parar, ordenar ideas y encontrar un poco más de claridad.", "Descubrir Mente", "/mente/", "Fotografía: sesión de acompañamiento", true) }}
      {{ pillar("Pilar III", "Movimiento", "Pilates", "A través de Pilates te acompañamos a conocer mejor tu cuerpo, ganar fuerza y volver a moverte con más libertad. Cada sesión se adapta a ti, a tu ritmo y a lo que necesitas en ese momento.", "Descubrir Movimiento", "/movimiento/", "Fotografía: clase de movimiento") }}
    </div>
  </div>
</section>

<section class="section section--alt" id="areas-de-trabajo">
  <div class="container">
    {{ sectionHead("Metodología aplicada", "Áreas de Trabajo", "Especialidades guiadas por profesionales sanitarios y docentes certificados.", "center") }}

    {% set cuerpoItems = [
      { title: "Prevención", body: "Higiene postural y cribado preventivo en el entorno laboral y deportivo." },
      { title: "Fisioterapia", body: "Terapia manual ortopédica, punción seca y modulación miofascial." },
      { title: "Recuperación", body: "Readaptación funcional post-quirúrgica y vuelta al movimiento activo." }
    ] %}
    {% set menteItems = [
      { title: "Orientación", body: "Clarificación vocacional, resolución de bloqueos y toma de decisiones." },
      { title: "Apoyo", body: "Escucha guiada, gestión de la ansiedad vital y acompañamiento emocional." },
      { title: "Formación", body: "Programas específicos para: Técnico de Educación Infantil, Magisterio y Auxiliar Administrativo." }
    ] %}
    {% set movimientoItems = [
      { title: "Pilates", body: "Clases individuales y en grupos muy reducidos en Reformer, Cadillac y suelo con accesorios terapéuticos." }
    ] %}

    <div class="grid area-cards-mobile">
      {{ areaCard(iconCuerpo(), "Cuerpo", cuerpoItems, "Sesiones individuales") }}
      {{ areaCard(iconMente(), "Mente", menteItems, "Personal y formativo") }}
      {{ areaCard(iconMovimiento(), "Movimiento", movimientoItems, "Grupos reducidos y 1:1", "Próximamente nuevas disciplinas conscientes") }}
    </div>

    {% set cuerpoRows = [
      { label: "Prevención", url: "/cuerpo/" },
      { label: "Fisioterapia", url: "/cuerpo/fisioterapia/" },
      { label: "Recuperación", url: "/cuerpo/" }
    ] %}
    {% set menteRows = [
      { label: "Orientación", url: "/mente/" },
      { label: "Apoyo", url: "/mente/" },
      { group: "Formación específica", items: [
        { label: "Técnico de Educación Infantil", url: "/formacion/" },
        { label: "Magisterio", url: "/formacion/" },
        { label: "Auxiliar Administrativo", url: "/formacion/" }
      ] }
    ] %}
    {% set movimientoRows = [
      { label: "Pilates (Suelo)", url: "/movimiento/" }
    ] %}

    <div class="area-cards-desktop">
      {{ areaListCard(iconCuerpo(), "Cuerpo", cuerpoRows, "Sesiones individuales") }}
      {{ areaListCard(iconMente(), "Mente", menteRows, "Personal y formativo") }}
      {{ areaListCard(iconMovimiento(), "Movimiento", movimientoRows, "Grupos reducidos y 1:1", "Próximamente nuevas disciplinas conscientes") }}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ sectionHead("Enfoque personalizado", "Para quién es Integra Studio", "", "center") }}
    <div class="grid">
      {{ card("", "Quien busca recuperarse", "Personas en proceso de rehabilitación física que necesitan un acompañamiento cercano y técnico.", "", "") }}
      {{ card("", "Quien busca claridad mental", "Quienes atraviesan procesos de cambio, estudio u orientación y buscan un espacio de apoyo.", "", "") }}
      {{ card("", "Quien busca moverse mejor", "Personas que quieren ganar fuerza, movilidad y bienestar a través del movimiento consciente.", "", "") }}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    {{ sectionHead("Experiencias", "Voces del estudio", "", "center") }}
    <div class="grid">
      {{ quoteCard("Encontré un espacio donde cada profesional entiende cómo se conecta mi cuerpo con mi cabeza.", "María G.", "paciente de Fisioterapia") }}
      {{ quoteCard("El acompañamiento en Mente me dio herramientas reales, con cercanía y sin prisas.", "Javier R.", "paciente de Mente") }}
      {{ quoteCard("Las clases de Movimiento cambiaron mi relación con mi cuerpo por completo.", "Laura S.", "alumna de Movimiento") }}
    </div>
  </div>
</section>

{{ ctaBanner("", "Empieza tu proceso hoy", "Da el primer paso hacia un bienestar integral, con un equipo que te acompaña en cada etapa.", "Reservar una sesión", "/contacto/", "Conocer el método", "/metodo/") }}
