            </svg>
          </span>
          <p>Cuerpo</p>
        </div>
        <div class="concept-graphic__card">
          <span class="concept-graphic__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="17" viewBox="0 0 16 17" fill="none">
