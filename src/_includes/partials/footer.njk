<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">{{ site.name }}</p>
      <p class="site-footer__tagline">{{ site.footer.tagline }}</p>
      <span class="site-footer__tag">{{ site.footer.tag }}</span>
    </div>

    <div class="footer-col footer-col--pilares">
      <p class="footer-col__title">Pilares</p>
      <ul>
        {% for item in site.footer.pilares %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-col footer-col--nav">
      <p class="footer-col__title">Navegación</p>
      <ul>
        {% for item in site.footer.nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-col footer-col--contact">
      <p class="footer-col__title">Contacto</p>
      <ul>
        <li>{{ site.footer.address }}</li>
        <li><a href="tel:{{ site.phone }}">{{ site.phone }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li class="footer-col__hours">{{ site.footer.hours }}</li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom">
    <ul class="site-footer__legal">
      {% for item in site.footer.legal %}
      <li><a href="{{ item.url }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
    <p>&copy; {{ site.name }}. Todos los derechos reservados.</p>
  </div>
</footer>
