<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">{{ site.name }}</p>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
    </div>

    <div class="footer-col">
      <p class="footer-col__title">Navegación</p>
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="site-footer__contact">
      <p class="eyebrow">Ubicación &amp; contacto</p>
      <p>{{ site.address[0] }}<br>{{ site.address[1] }}</p>
      <p><a class="link-arrow" href="tel:{{ site.phone }}">{{ site.phone }}</a></p>
      <p><a class="link-arrow" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <a class="link-arrow" href="{{ site.mapsUrl }}" target="_blank" rel="noopener">Cómo llegar →</a>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ site.currentYear }} {{ site.name }}. Todos los derechos reservados.</p>
  </div>
</footer>
