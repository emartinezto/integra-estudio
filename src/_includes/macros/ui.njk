{% macro areaCard(icon, title, items, tag, note) %}
<div class="area-card">
  <div class="area-card__head">
    <span class="area-card__icon" aria-hidden="true">{{ icon }}</span>
    <h3>{{ title }}</h3>
  </div>
  <div class="area-card__list">
    {% for item in items %}
    <div class="area-card__item">
      <span class="area-card__check" aria-hidden="true">{{ iconCheck() }}</span>
      <div>
        <p class="area-card__item-title">{{ item.title }}</p>
        <p class="area-card__item-body">{{ item.body }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
  {% if note %}
  <p class="area-card__note">
    <span class="area-card__note-icon" aria-hidden="true">{{ iconClock() }}</span>
    {{ note }}
  </p>
  {% endif %}
  {% if tag %}<span class="area-card__tag">{{ tag }}</span>{% endif %}
</div>
{% endmacro %}

{% macro areaListCard(icon, title, rows, tag, note) %}
<div class="area-list-card">
  <div class="area-list-card__head">
    <h3>{{ title }}</h3>
    <span class="area-list-card__icon" aria-hidden="true">{{ icon }}</span>
  </div>
  <div class="area-list-card__rows">
    {% for row in rows %}
      {% if row.group %}
        <p class="area-list-card__group-title">{{ row.group }}</p>
        <div class="area-list-card__group-rows">
          {% for sub in row.items %}
          <a class="area-list-card__group-row" href="{{ sub.url }}">
            <span>{{ sub.label }}</span>
            <span class="area-list-card__row-arrow" aria-hidden="true">→</span>
          </a>
          {% endfor %}
        </div>
      {% else %}
        <a class="area-list-card__row" href="{{ row.url }}">
          <span>{{ row.label }}</span>
          <span class="area-list-card__row-arrow" aria-hidden="true">→</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  {% if note %}
  <div class="area-list-card__note">
    <span>{{ note }}</span>
    <span class="area-list-card__note-icon" aria-hidden="true">{{ iconClock() }}</span>
  </div>
  {% endif %}
  {% if tag %}<span class="area-list-card__tag">{{ tag }}</span>{% endif %}
</div>
{% endmacro %}

{% macro personaCard(number, headline, body) %}
<div class="persona-card">
  <p class="persona-card__number">{{ number }}</p>
  <p class="persona-card__headline">{{ headline }}</p>
  <p class="persona-card__body">{{ body }}</p>
</div>
{% endmacro %}

{% macro personaCardDesktop(icon, label, headline, body) %}
<div class="persona-list-card">
  <span class="persona-list-card__icon" aria-hidden="true">{{ icon }}</span>
  <p class="persona-list-card__label">{{ label }}</p>
  <h3 class="persona-list-card__headline">{{ headline }}</h3>
  <p class="persona-list-card__body">{{ body }}</p>
</div>
{% endmacro %}

{% macro atmosphereCard(imageLabel, label, icon, title) %}
<div class="atmosphere-card">
  {{ mediaPlaceholder(imageLabel) }}
  <div class="atmosphere-card__body">
    <div class="atmosphere-card__row">
      <p class="atmosphere-card__label">{{ label }}</p>
      {% if icon %}<span class="atmosphere-card__icon" aria-hidden="true">{{ icon }}</span>{% endif %}
    </div>
    <h3>{{ title }}</h3>
  </div>
</div>
{% endmacro %}

{% macro button(text, url, style="primary") %}
<a class="btn btn--{{ style }}" href="{{ url }}">{{ text }}</a>
{% endmacro %}

{% macro mediaPlaceholder(label, ratio="4 / 3") %}
<div class="media-placeholder" style="--ratio: {{ ratio }};">
  <span>{{ label }}</span>
</div>
{% endmacro %}

{% macro sectionHead(eyebrowText, title, body, align="left") %}
<div class="section-head section-head--{{ align }}">
  <div class="section-head__heading">
    <p class="eyebrow">{{ eyebrowText }}</p>
    <h2>{{ title }}</h2>
  </div>
  {% if body %}<p class="section-head__body">{{ body }}</p>{% endif %}
</div>
{% endmacro %}

{% macro pillar(tag, title, subtitle, body, ctaText, ctaUrl, imageLabel, reverse=false, mediaTag="", points=[]) %}
<div class="pillar {% if reverse %}pillar--reverse{% endif %}">
  <div class="pillar__media">
    {{ mediaPlaceholder(imageLabel) }}
    {% if mediaTag or tag %}<span class="pillar__tag pillar__tag--floating">{{ mediaTag or tag }}</span>{% endif %}
  </div>
  <div class="pillar__content">
    {% if tag %}<p class="pillar__tag pillar__tag--inline">{{ tag }}</p>{% endif %}
    <h3>{{ title }}</h3>
    {% if subtitle %}<p class="pillar__subtitle">{{ subtitle }}</p>{% endif %}
    <p>{{ body }}</p>
    {% if points and points|length %}
    <div class="pillar__points">
      <p class="pillar__points-label">Puntos clave</p>
      <div class="pillar__points-list">
        {% for point in points %}<span class="pillar__point">{{ point }}</span>{% endfor %}
      </div>
    </div>
    {% endif %}
    {% if ctaUrl %}<a class="link-arrow" href="{{ ctaUrl }}">{{ ctaText }} →</a>{% endif %}
  </div>
</div>
{% endmacro %}

{% macro card(eyebrowText, title, body, ctaText, ctaUrl, variant="", icon="", footerLabel="", number="") %}
<div class="card {% if variant %}card--{{ variant }}{% endif %}">
  {% if number %}
  <div class="card__head">
    <span class="card__number">{{ number }}</span>
    {% if icon %}<span class="card__icon" aria-hidden="true">{{ icon }}</span>{% endif %}
  </div>
  {% elif icon %}
  <span class="card__icon" aria-hidden="true">{{ icon }}</span>
  {% endif %}
  {% if eyebrowText %}<p class="eyebrow">{{ eyebrowText }}</p>{% endif %}
  <h3>{{ title }}</h3>
  <p>{{ body }}</p>
  {% if footerLabel %}<p class="eyebrow card__footer">{{ footerLabel }}</p>{% endif %}
  {% if ctaUrl %}<a class="link-arrow" href="{{ ctaUrl }}">{{ ctaText }} →</a>{% endif %}
</div>
{% endmacro %}

{% macro quoteCard(quote, author, role, icon) %}
<div class="quote-card">
  <p class="quote-card__text">“{{ quote }}”</p>
  {% if icon %}
  <div class="quote-card__meta">
    <span class="quote-card__avatar" aria-hidden="true">{{ icon }}</span>
    <div>
      <p class="quote-card__author">{{ author }}</p>
      {% if role %}<p class="quote-card__role">{{ role }}</p>{% endif %}
    </div>
  </div>
  {% else %}
  <p class="quote-card__author">{{ author }}{% if role %} · {{ role }}{% endif %}</p>
  {% endif %}
</div>
{% endmacro %}

{% macro quoteInline(quote, author) %}
<blockquote class="quote-inline">
  <p class="quote-inline__text">«{{ quote }}»</p>
  {% if author %}<p class="quote-inline__author">— {{ author }}</p>{% endif %}
</blockquote>
{% endmacro %}

{% macro featureRow(icon, title, body) %}
<div class="feature-row">
  <div class="feature-row__head">
    <span class="feature-row__icon" aria-hidden="true">{{ icon }}</span>
    <h3>{{ title }}</h3>
  </div>
  <p class="feature-row__body">{{ body }}</p>
</div>
{% endmacro %}

{% macro pillarOverviewCard(icon, label, title, body, ctaText, ctaUrl, active=false) %}
<div class="pillar-overview-card {% if active %}pillar-overview-card--active{% endif %}">
  <span class="pillar-overview-card__icon" aria-hidden="true">{{ icon }}</span>
  <p class="pillar-overview-card__label">{{ label }}</p>
  <h3>{{ title }}</h3>
  <p class="pillar-overview-card__body">{{ body }}</p>
  <div class="pillar-overview-card__divider"></div>
  {% if active %}
  <p class="pillar-overview-card__status">
    {{ ctaText }}
    <span class="pillar-overview-card__status-icon" aria-hidden="true">{{ iconCheck() }}</span>
  </p>
  {% else %}
  <a class="link-arrow" href="{{ ctaUrl }}">{{ ctaText }} →</a>
  {% endif %}
</div>
{% endmacro %}

{% macro contactCard(icon, title, lines, footerText, footerUrl) %}
<div class="contact-card">
  <span class="contact-card__icon" aria-hidden="true">{{ icon }}</span>
  <h3>{{ title }}</h3>
  <p class="contact-card__lines">{{ lines | safe }}</p>
  {% if footerUrl %}
  <a class="contact-card__footer link-arrow" href="{{ footerUrl }}">{{ footerText }} →</a>
  {% elif footerText %}
  <p class="contact-card__footer-note">{{ footerText }}</p>
  {% endif %}
</div>
{% endmacro %}

{% macro faqItem(question, answer) %}
<details class="faq-item">
  <summary class="faq-item__summary">
    <span>{{ question }}</span>
    <span class="faq-item__icon" aria-hidden="true">+</span>
  </summary>
  <div class="faq-item__answer"><p>{{ answer }}</p></div>
</details>
{% endmacro %}

{% macro opoCard(icon, category, title, body, checks, ctaText, ctaUrl) %}
<div class="opo-card">
  <span class="opo-card__icon" aria-hidden="true">{{ icon }}</span>
  <p class="opo-card__category">{{ category }}</p>
  <h3 class="opo-card__title">{{ title }}</h3>
  <p class="opo-card__body">{{ body }}</p>
  <ul class="opo-card__checks">
    {% for item in checks %}
    <li><span class="opo-card__check-icon" aria-hidden="true">{{ iconCheck() }}</span>{{ item }}</li>
    {% endfor %}
  </ul>
  {% if ctaUrl %}<a class="link-arrow opo-card__cta" href="{{ ctaUrl }}">{{ ctaText }} →</a>{% endif %}
</div>
{% endmacro %}

{% macro integrationRow(number, tag, title, body, ctaText, ctaUrl) %}
<div class="integration-row">
  <p class="integration-row__number">{{ number }}</p>
  <span class="integration-row__tag">{{ tag }}</span>
  <h3 class="integration-row__title">{{ title }}</h3>
  <p class="integration-row__body">{{ body }}</p>
  <a class="integration-row__cta link-arrow" href="{{ ctaUrl }}">{{ ctaText }} →</a>
</div>
{% endmacro %}

