{% macro ctaBanner(eyebrowText, title, body, ctaText, ctaUrl, secondaryText, secondaryUrl, note, icon, noteIcon=true, align="center", decorative=false) %}
<section class="cta-banner">
  <div class="cta-banner__inner {% if align == 'left' %}cta-banner__inner--left{% endif %}">
    {% if decorative %}<span class="cta-banner__blob" aria-hidden="true"></span>{% endif %}
    {% if icon %}<span class="cta-banner__icon" aria-hidden="true">{{ icon }}</span>{% endif %}
    {% if eyebrowText %}<p class="eyebrow eyebrow--light">{{ eyebrowText }}</p>{% endif %}
    <h2>{{ title }}</h2>
    {% if body %}<p>{{ body }}</p>{% endif %}
    <div class="cta-banner__actions">
      <a class="btn btn--light" href="{{ ctaUrl }}">{{ ctaText }}</a>
      {% if secondaryUrl %}<a class="cta-banner__secondary" href="{{ secondaryUrl }}">{{ secondaryText }}</a>{% endif %}
      {% if note and align == 'left' %}
      <p class="cta-banner__note">
        {% if noteIcon %}<span class="cta-banner__note-icon" aria-hidden="true">{{ iconPin() }}</span>{% endif %}
        {{ note }}
      </p>
      {% endif %}
    </div>
    {% if note and align != 'left' %}
    <p class="cta-banner__note">
      {% if noteIcon %}<span class="cta-banner__note-icon" aria-hidden="true">{{ iconPin() }}</span>{% endif %}
      {{ note }}
    </p>
    {% endif %}
  </div>
</section>
{% endmacro %}

{% macro breadcrumb(items) %}
<nav class="breadcrumb" aria-label="Ruta de navegación">
  <ol>
    <li><a href="/">Inicio</a></li>
    {% for item in items %}
      <li aria-hidden="true">/</li>
      <li>{% if item.url %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}<span aria-current="page">{{ item.label }}</span>{% endif %}</li>
    {% endfor %}
  </ol>
</nav>
{% endmacro %}
